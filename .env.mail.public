# Stalwart bootstrap / public URL used by the admin UI and Bulwark's JMAP client
HERMES_MAIL_SERVER_URL=http://localhost:${HERMES_PORT_PREFIX}19

# Optional hostname used only for documentation/branding of the Bulwark webmail UI
HERMES_MAIL_WEBMAIL_HOSTNAME=webmail.example.org

# One-time Stalwart bootstrap admin used to complete the first login at /admin
HERMES_MAIL_ADMIN_USER=admin
HERMES_MAIL_ADMIN_PASSWORD=changeme

# Bulwark runtime configuration
HERMES_MAIL_WEBMAIL_SESSION_SECRET=
HERMES_MAIL_WEBMAIL_APP_NAME="Hermes Mail"
HERMES_MAIL_WEBMAIL_SHORT_NAME=Hermes
HERMES_MAIL_WEBMAIL_DESCRIPTION="Hermes webmail powered by Bulwark and Stalwart"
HERMES_MAIL_WEBMAIL_COMPANY_NAME=Hermes
HERMES_MAIL_WEBMAIL_WEBSITE_URL=https://example.org
