# Stalwart bootstrap / public URL used by the admin UI and Bulwark's JMAP client
# When this file is sourced by init-mail.sh and rendered through envsubst, ${HERMES_PORT_PREFIX} is expanded by the shell.
HERMES_MAIL_SERVER_URL=http://localhost:${HERMES_PORT_PREFIX}19

# Optional hostname used only for documentation/branding of the Bulwark webmail UI
HERMES_MAIL_WEBMAIL_HOSTNAME=webmail.example.org

# One-time Stalwart bootstrap admin used to complete the first login at /admin
HERMES_MAIL_ADMIN_USER=admin
HERMES_MAIL_ADMIN_PASSWORD=

# Optional domain helpers for Stalwart setup in the admin UI
HERMES_MAIL_PRIMARY_DOMAIN=example.org
HERMES_MAIL_ADDITIONAL_DOMAINS=
HERMES_MAIL_ALIAS_DOMAINS=

# Optional Stalwart bootstrap planning note: RocksDB or Postgres
# If you choose Postgres in Stalwart, use the HERMES_MAIL_METADATA_DB_* values below.
# init-mail.sh auto-generates the DB password when left blank.
HERMES_MAIL_METADATA_BACKEND=rocksdb
HERMES_MAIL_METADATA_DB_HOST=hermes-mail-postgres
HERMES_MAIL_METADATA_DB_PORT=5432
HERMES_MAIL_METADATA_DB_NAME=stalwart
HERMES_MAIL_METADATA_DB_USER=stalwart
HERMES_MAIL_METADATA_DB_PASSWORD=

# Optional storage backend selector for Stalwart after bootstrap: local or s3
HERMES_MAIL_STORAGE_BACKEND=local
HERMES_MAIL_S3_BUCKET=
HERMES_MAIL_S3_ENDPOINT=
HERMES_MAIL_S3_REGION=us-east-1
HERMES_MAIL_S3_ACCESS_KEY=
HERMES_MAIL_S3_SECRET_KEY=
HERMES_MAIL_S3_PATH_STYLE=true

# Bulwark runtime configuration
HERMES_MAIL_WEBMAIL_SESSION_SECRET=
HERMES_MAIL_WEBMAIL_APP_NAME="Hermes Mail"
HERMES_MAIL_WEBMAIL_SHORT_NAME=Hermes
HERMES_MAIL_WEBMAIL_DESCRIPTION="Hermes webmail powered by Bulwark and Stalwart"
HERMES_MAIL_WEBMAIL_COMPANY_NAME=Hermes
HERMES_MAIL_WEBMAIL_WEBSITE_URL=https://example.org
