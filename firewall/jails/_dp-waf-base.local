# please calibrate to your needs.
[DEFAULT]
ignoreip = 


[dp-nginx-patience]
enabled 	= true
filter 		= dp-nginx-patience
port     	= http,https
action 		=	route
logpath 	= ${HERMES_WEB_ACESS_LOG_PATH}
findtime 	= ${HERMES_BLOCKIP_DEFAULT_LOOKBACK}
bantime 	= ${HERMES_BLOCKIP_SHORT_DURATION}
maxretry 	= ${HERMES_BLOCKIP_10_PATIANCE_DURATION}

[dp-nginx-shortcircuit]
enabled 	= true
filter 		= dp-nginx-patience
port   		= http,https
action 		= route
logpath 	= ${HERMES_WEB_ACESS_LOG_PATH}
findtime 	= ${HERMES_BLOCKIP_SHORT_LOOKBACK}
bantime 	= ${HERMES_BLOCKIP_DEFAULT_DURATION}
maxretry 	= ${HERMES_BLOCKIP_2_PATIENCE_DURATION}

[dp-matrix-patience]
enabled 	= true
filter 		= dp-matrix-patience
port   		= http,https
action 		= route
logpath 	= ${HERMES_WEB_ACESS_LOG_PATH}
findtime 	= ${HERMES_BLOCKIP_SHORT_LOOKBACK}
bantime 	= ${HERMES_BLOCKIP_DEFAULT_DURATION}
maxretry 	= ${HERMES_BLOCKIP_1_PATIENCE_DURATION}

[dp-cloud-drive-patience]
enabled 	= true
filter 		= dp-cloud-drive-patience
port   		= http,https
action 		= route
logpath 	= ${HERMES_WEB_ACESS_LOG_PATH}
findtime 	= ${HERMES_BLOCKIP_SHORT_LOOKBACK}
bantime 	= ${HERMES_BLOCKIP_DEFAULT_DURATION}
maxretry 	= ${HERMES_BLOCKIP_1_PATIENCE_DURATION}

[dp-mail-badauth]
enabled 	= true
filter 		= dp-mail-badauth
action 		= route
logpath 	= /var/log/messages
findtime 	= ${HERMES_BLOCKIP_DEFAULT_LOOKBACK}
bantime 	= ${HERMES_BLOCKIP_DEFAULT_DURATION}
maxretry 	= ${HERMES_BLOCKIP_0_PATIENCE_DURATION}
action 		= dp-action-docker

[nextcloud]
backend 	= auto
enabled 	= true
port 			= 80,443
protocol 	= tcp
filter 		= dp-nextcloud-badauth
maxretry 	= ${HERMES_BLOCKIP_0_PATIENCE_DURATION}
bantime 	= ${HERMES_BLOCKIP_DEFAULT_DURATION}
findtime 	= ${HERMES_BLOCKIP_DEFAULT_LOOKBACK}
logpath 	= ${HERMES_CLOUD_LOG_PATH}

[postfix]

enabled = true
filter = postfix
port = smtp,465,submission,imap,imaps,pop3,pop3s
action = iptables[name=Postfix, port=smtp, protocol=tcp]
logpath = /var/log/mail.log
bantime = ${HERMES_BLOCKIP_LONG_DURATION}
maxretry = ${HERMES_BLOCKIP_0_PATIENCE_DURATION}
findtime = ${HERMES_BLOCKIP_10_PATIENCE_DURATION}
